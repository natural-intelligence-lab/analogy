firmata firmata ( // arduino_uno
    autostart = true
    serial_port = '/dev/cu.usbmodem2401'
    data_interval = 1ms // for analog input
    reconnect_interval = 1s
    ) {
    firmata_digital_output (
        pin_number = 3 // 13 for LED light on arduino
        value = reward_line
        )
    }
